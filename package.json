{
  "name": "hub",
  "productName": "Hub",
  "version": "0.1.0",
  "description": "Keep your websites in one desktop app with a quick-switch sidebar.",
  "main": "./out/main/index.js",
  "author": "shivamgupta1319",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "shoot": "electron-vite build && node scripts/shoot.mjs",
    "smoke": "electron-vite build && node scripts/smoke.mjs",
    "icons": "env -u ELECTRON_RUN_AS_NODE electron scripts/render-icons.cjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "desktopName": "hub.desktop"
}
